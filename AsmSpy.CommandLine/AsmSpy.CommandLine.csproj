<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <Company>Suteki Ltd</Company>
    <Copyright>Copyright Suteki Ltd</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Nullable>disable</Nullable>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <TestResults>false</TestResults>
    <TestCoverage>false</TestCoverage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ILMerge" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Extensions.CommandLineUtils" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AsmSpy.Core\AsmSpy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>87c71050-29d8-4d2b-ad59-9f950e659915</_Parameter1>
    </AssemblyAttribute>
    <EmbeddedResource Update="AsmSpy.CommandLine.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AsmSpy.CommandLine.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="AsmSpy.CommandLine.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>AsmSpy.CommandLine.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <Target Name="MergeExecutable" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Inputs="$(TargetPath);@(ReferenceCopyLocalPaths);$(MSBuildProjectFullPath);$(AssemblyOriginatorKeyFile);$(MSBuildProjectDirectory)\ilmerge.internalize.ignore.txt"
          Outputs="$(TargetDir)AsmSpy.exe">
    <PropertyGroup>
      <FrameworkPath>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2</FrameworkPath>
      <ILMergeExe>$(PkgILMerge)\tools\net452\ILMerge.exe</ILMergeExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(ILMergeExe)')" Text="Restore ILMerge before building the Windows executable." />
    <Error Condition="!Exists('$(FrameworkPath)\mscorlib.dll')" Text="Restore the .NET Framework 4.7.2 reference assemblies before merging." />
    <!-- ILMerge cannot read portable PDBs; keep them for the unmerged assemblies only. -->
    <Exec WorkingDirectory="$(TargetDir)"
          Command="&quot;$(ILMergeExe)&quot; /keyfile:&quot;$(AssemblyOriginatorKeyFile)&quot; /ndebug /targetplatform:&quot;v4,$(FrameworkPath)&quot; /lib:&quot;$(FrameworkPath)\Facades&quot; /internalize:&quot;$(MSBuildProjectDirectory)\ilmerge.internalize.ignore.txt&quot; /target:exe /out:AsmSpy.exe /log:ilmerge.msbuild.log /allowDup AsmSpy.CommandLine.exe AsmSpy.Core.dll Microsoft.Extensions.CommandLineUtils.dll" />
  </Target>
</Project>
