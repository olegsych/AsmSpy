<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Company>Suteki Ltd</Company>
    <Copyright>Copyright Suteki Ltd</Copyright>
    <Nullable>disable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Libraries for viewing assembly references and resolving dependency conflicts.</Description>
    <PackageTags>asmspy;core</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>82f59078-4eff-405f-8daa-5892c5ff182c</_Parameter1>
    </AssemblyAttribute>
    <Compile Remove="UnitTests.cs" />
    <None Include="..\licence.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" PrivateAssets="all" />
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <!-- Preserve attribution and the existing undocumented, nullable-oblivious API. -->
    <Authors>Mike Hadlow, Rahul Nath</Authors>
    <DocumentationFile />
  </PropertyGroup>
</Project>
